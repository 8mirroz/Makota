{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://makota.ai/schemas/machine-telemetry.schema.json",
  "title": "MachineTelemetryEvent",
  "description": "Схема данных телеметрии станка ЧПУ (MTConnect / OPC UA / Edge Hub).",
  "type": "object",
  "required": [
    "timestamp",
    "machine_id",
    "execution_state",
    "spindle"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "machine_id": {
      "type": "string",
      "description": "Идентификатор станка (например, CNC-LATHE-01, VMC-5AXIS-02)."
    },
    "controller_model": {
      "type": "string",
      "enum": ["Fanuc 0i-TF", "Siemens Sinumerik 840D", "Heidenhain TNC 640", "Syntec", "НЦ-31 (Модерн)", "Другое"]
    },
    "execution_state": {
      "type": "string",
      "enum": ["ACTIVE", "READY", "STOPPED", "INTERRUPTED", "FEED_HOLD", "ALARM", "WARM_UP"]
    },
    "active_program": {
      "type": "string",
      "description": "Имя текущей NC-программы (O1001.nc)."
    },
    "active_tool_id": {
      "type": "string",
      "description": "Номер инструмента в револьверной головке / магазине (T0101)."
    },
    "spindle": {
      "type": "object",
      "required": ["speed_rpm", "load_percent"],
      "properties": {
        "speed_rpm": { "type": "number", "minimum": 0 },
        "load_percent": { "type": "number", "minimum": 0, "maximum": 200 },
        "temperature_celsius": { "type": "number" }
      }
    },
    "feed": {
      "type": "object",
      "properties": {
        "actual_rate_mm_min": { "type": "number" },
        "override_percent": { "type": "number", "minimum": 0, "maximum": 200 }
      }
    },
    "alarms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["WARNING", "FAULT", "CRITICAL"] },
          "description": { "type": "string" }
        }
      }
    },
    "part_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
